<%- include('partials/head') %>

<div class="admin-intro">
  <strong>Chỉnh banner</strong> — ảnh/slide lớn ở đầu trang chủ. Đổi ảnh ở mục <strong>“Ảnh nền banner”</strong> bên dưới (chọn file trong máy hoặc dán link), ảnh xem trước hiện ngay.
  <ul class="admin-intro__tips">
    <li>Sửa xong nhớ bấm <strong>Lưu banner</strong>.</li>
  </ul>
</div>

<form class="form-card" method="post" action="<%= formAction %>" enctype="multipart/form-data">
  <div class="form-grid">
    <div class="form-row form-row--full">
      <label>Tiêu đề</label>
      <input type="text" name="title" value="<%= banner.title || '' %>" />
    </div>
    <div class="form-row form-row--full">
      <label>Mô tả phụ</label>
      <textarea name="subtitle" rows="2"><%= banner.subtitle || '' %></textarea>
    </div>
    <div class="form-row">
      <label>Chữ trên nút</label>
      <input type="text" name="button_text" value="<%= banner.button_text || '' %>" placeholder="Shop Now" />
    </div>
    <div class="form-row">
      <label>Đường dẫn khi bấm nút</label>
      <input type="text" name="link" value="<%= banner.link || '' %>" placeholder="/products" />
    </div>
    <%- include('partials/media-field', {
      label: '🖼️ Ảnh nền banner',
      kind: 'image',
      currentUrl: banner.image || '',
      fileName: 'image',
      urlName: 'image_url',
      removeName: 'remove_image',
      accept: 'image/*',
      placeholder: 'https://example.com/banner.jpg',
      hint: 'Chọn ảnh ngang từ máy hoặc dán link ảnh trực tiếp. Ảnh xem trước sẽ hiện ngay bên dưới.'
    }) %>
    <%- include('partials/media-field', {
      label: 'Video nền (không bắt buộc)',
      kind: 'video',
      currentUrl: banner.video || '',
      fileName: 'video',
      urlName: 'video_url',
      removeName: 'remove_video',
      accept: 'video/mp4,video/webm',
      placeholder: 'Link YouTube, Vimeo, MP4 hoặc WebM',
      hint: 'Không bắt buộc. Nếu có video thì video sẽ thay cho ảnh nền.'
    }) %>
    <div class="form-row">
      <label>Thứ tự</label>
      <input type="number" name="sort_order" value="<%= banner.sort_order || 0 %>" />
    </div>
    <div class="form-row">
      <label class="check"><input type="checkbox" name="is_active" <%= (banner.is_active===undefined||banner.is_active)?'checked':'' %> /> Hiển thị trên web</label>
    </div>
  </div>
  <div class="form-actions">
    <button type="submit" class="btn btn--primary">Lưu banner</button>
    <a href="/admin/banners" class="btn btn--ghost">Hủy</a>
  </div>
</form>

<%- include('partials/foot') %>
